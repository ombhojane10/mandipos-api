# Copy to .env for local development (pnpm dev). Never commit .env.
APP_ENV=local
PORT=3000
# Local Postgres: the app connects as the restricted runtime role; migrations as the owner.
DATABASE_URL=postgres://mandipos_api:local-only@localhost/mandipos_local
DATABASE_URL_DIRECT=postgres://localhost/mandipos_local
JWT_SECRET=change-me-to-a-long-random-string-32chars
OTP_HASH_SECRET=change-me-too-16chars
# Only needed in staging/production (local prints the OTP to the log):
# TWOFACTOR_API_KEY=
# TWOFACTOR_OTP_TEMPLATE_NAME=
