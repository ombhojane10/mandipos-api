# Copy to .env for local development (pnpm dev). Never commit .env.
APP_ENV=local
PORT=3000
# Local Postgres: the app connects as the restricted runtime role; migrations as the owner.
DATABASE_URL=postgres://mandipos_api:local-only@localhost/mandipos_local
DATABASE_URL_DIRECT=postgres://localhost/mandipos_local
JWT_SECRET=change-me-to-a-long-random-string-32chars
OTP_HASH_SECRET=change-me-too-16chars
# Only needed in staging/production (local prints the OTP to the log):
# TWOFACTOR_API_KEY=
# TWOFACTOR_OTP_TEMPLATE_NAME=
# Grahak eKYC (optional locally): ULIP DigiLocker through the Mumbai proxy.
# ULIP_BASE_URL=https://www.ulipstaging.dpiit.gov.in/ulip/v1.0.0
# ULIP_USERNAME=
# ULIP_PASSWORD=
# ULIP_PROXY_URL=
# KYC_DATA_KEY=at-least-32-random-characters
# DigiLocker eKYC through Surepass (token from console.surepass.app > API Key):
# SUREPASS_BASE_URL=https://sandbox.surepass.app
# SUREPASS_TOKEN=
# DigiLocker eKYC through Sandbox.co.in (live keys; test keys only answer saved examples):
# SANDBOX_API_KEY=key_live_...
# SANDBOX_API_SECRET=secret_live_...
# KYC_DIGILOCKER_PROVIDER=sandbox   # or surepass; unset = sandbox when its keys are set
